{
  "description": "Unstyled, accessible UI behaviours for Perimetre projects, built on UI SDK. Replaces @perimetre/ui for new work",
  "devDependencies": {
    "@googlemaps/js-api-loader": "^2.0.2",
    "@perimetre/eslint-config-base": "workspace:*",
    "@perimetre/eslint-config-react": "workspace:*",
    "@types/google.maps": "^3.58.1",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@ui-sdk/core": "0.1.0-beta.17",
    "@ui-sdk/react": "0.1.0-beta.17",
    "eslint": "^9.39.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3"
  },
  "exports": {
    "./*": {
      "default": "./dist/*/index.js",
      "types": "./dist/*/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "license": "GPL-3.0",
  "name": "@perimetre/ui-behaviors",
  "peerDependencies": {
    "@googlemaps/js-api-loader": ">=2",
    "@types/google.maps": ">=3.58",
    "@ui-sdk/core": "0.1.0-beta.17",
    "@ui-sdk/react": "0.1.0-beta.17",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "@googlemaps/js-api-loader": {
      "optional": true
    },
    "@types/google.maps": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "directory": "packages/ui-behaviors",
    "type": "git",
    "url": "https://github.com/perimetre/framework.git"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "version": "0.0.0"
}
